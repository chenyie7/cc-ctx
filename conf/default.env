# cc-ctx defaults — a fallback only.
#
# Your real settings live in ~/.claude/cc-ctx/cc-ctx.env, which setup writes once
# and never overwrites. Editing there is safe across plugin updates.
#
# Bump this when a default changes meaning rather than merely changing value.
# setup warns when your config predates it; `cc-ctx setup --reset-config`
# regenerates the file from these defaults (after backing it up).
#   2 — price table switched from USD to CNY. A config still holding the old
#       USD numbers would have them read as CNY, understating cost ~6.7x.
#   3 — prices and peak/off-peak rules moved out of this file into JSON
#       (conf/providers/*.json, conf/calendars/*.json). CC_CTX_PRICE_* and
#       CC_CTX_PEAK_* are no longer read at all, and are gone from this file.
CC_CTX_CONFIG_VERSION="3"

# ── Display ───────────────────────────────────────────────────────────────
# CC_CTX_RATE applies when a provider's price currency differs from the display
# currency.
CC_CTX_CURRENCY="CNY"
CC_CTX_SYMBOL="¥"
CC_CTX_RATE="6.67"

# ── Prices ────────────────────────────────────────────────────────────────
# Prices are JSON now, not env vars. Shipped table: conf/providers/deepseek.json
# To change a price, copy that file to ~/.claude/cc-ctx/providers/ and edit it —
# your copy wins over the shipped one and survives plugin updates.
CC_CTX_PROVIDERS_DIR=""
CC_CTX_CALENDARS_DIR=""
# Holiday calendar data: shipped snapshot + optional background refresh.
CC_CTX_REMOTE="on"
CC_CTX_REMOTE_TTL_MS="86400000"
CC_CTX_PROVIDER_URL=""
CC_CTX_CALENDAR_URL=""

# ── Peak / off-peak ───────────────────────────────────────────────────────
# The windows themselves now live in the provider JSON (deepseek.json), because
# they are part of that provider's price list.
# Minutes before a tier switch at which the status line starts counting down.
CC_CTX_TIER_ALERT_MINUTES="20"

# ── Layout ────────────────────────────────────────────────────────────────
# Which fields appear, and in what order. Delete any you do not want.
CC_CTX_FIELDS="context dir balance cost tier effort tokens brand model session hitrate calls"
CC_CTX_BRAND="cc-ctx"
CC_CTX_GAP="  "
CC_CTX_DIVIDER=" │ "
CC_CTX_PADDING="1"
# balanced — same number of lines, but spread evenly so no line looks truncated
# greedy   — fill each line to the terminal edge before wrapping
CC_CTX_WRAP="balanced"
CC_CTX_BAR_FULL="█"
CC_CTX_BAR_EMPTY_CHAR="░"
CC_CTX_BAR_WIDTH="10"
CC_CTX_CONTEXT_WARN="60"
CC_CTX_CONTEXT_HOT="85"

# ── Colour ────────────────────────────────────────────────────────────────
# Truecolor (38;2;R;G;B) with automatic downgrade to 256-colour when COLORTERM
# does not advertise truecolor. `CC_CTX_TRUECOLOR=off` forces 256-colour, `on`
# forces truecolor.
CC_CTX_TRUECOLOR="auto"
CC_CTX_COLOR_LABEL="38;2;110;118;129"
CC_CTX_COLOR_BRAND="38;2;148;163;184"
CC_CTX_COLOR_MODEL="38;2;198;160;246"
CC_CTX_COLOR_EFFORT="38;2;250;204;21"
CC_CTX_COLOR_DIR="38;2;56;189;248"
CC_CTX_COLOR_VALUE="38;2;226;232;240"
CC_CTX_COLOR_OK="38;2;74;222;128"
CC_CTX_COLOR_WARN="38;2;250;204;21"
CC_CTX_COLOR_HOT="38;2;248;113;113"
CC_CTX_COLOR_DIVIDER="38;2;71;85;105"
CC_CTX_COLOR_BAR_EMPTY="38;2;51;65;85"

# ── Balance ───────────────────────────────────────────────────────────────
CC_CTX_BALANCE_URL="https://api.deepseek.com/user/balance"
# Inside this window the cached figure is used as-is.
CC_CTX_BALANCE_TTL_MS="60000"
# Older than this, the status line waits for a fresh fetch rather than opening
# with a stale number. Between the two it shows the old figure with a "?" and
# refreshes in the background. Set to 0 to always wait, or very high to never.
CC_CTX_BALANCE_BLOCK_AFTER_MS="300000"
# Upper bound on that wait, so a slow network cannot stall the status line.
CC_CTX_BALANCE_TIMEOUT_MS="1500"
